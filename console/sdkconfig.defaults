CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# AI-Thinker ESP32-CAM: 4MB flash and quad PSRAM on GPIO16/17.
# Keep both at 40 MHz so HSPI stays free for the LCD.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_40M=y
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
CONFIG_CONSOLE_JPEG_ROTATE_0=y
